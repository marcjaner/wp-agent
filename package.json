    "test:live": "npm run build && node scripts/live-test.mjs",
    "bridge:package": "node scripts/package-bridge.mjs",
    "test:bridge": "npm run build && node scripts/bridge-live-test.mjs",
    "test:browser-map": "npm run build && node scripts/test-browser-map.mjs"
  },
  "dependencies": {
    "@wordpress/block-serialization-default-parser": "^5.36.0",
    "commander": "^14.0.0",
    "dotenv": "^17.2.2",
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
