{
  "name": "wp-agent",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "files": ["dist", "README.md", "LICENSE", "wp-agent-bridge", "scripts/package-bridge.mjs"],
  "bin": { "wp-agent": "dist/cli.js" },
  "exports": { ".": "./dist/index.js" },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "dev": "tsx src/cli.ts",
